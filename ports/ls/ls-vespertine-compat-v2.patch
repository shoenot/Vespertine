diff -ruN ls/ls/vesp_compat.c ls_patched/vesp_compat.c
--- ls/ls/vesp_compat.c	1970-01-01 00:00:00.000000000 +0000
+++ ls_patched/vesp_compat.c	2026-06-19 14:22:42.443877066 +0000
@@ -0,0 +1,101 @@
+#include "vesp_compat.h"
+
+#include <errno.h>
+#include <grp.h>
+#include <pwd.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+long long
+strtonum(const char *nptr, long long minval, long long maxval,
+    const char **errstrp)
+{
+    char *end;
+    long long value;
+    const char *err = NULL;
+
+    if (minval > maxval) {
+        if (errstrp)
+            *errstrp = "invalid";
+        errno = EINVAL;
+        return 0;
+    }
+
+    errno = 0;
+    value = strtoll(nptr, &end, 10);
+    if (nptr == end || *end != '\0')
+        err = "invalid";
+    else if ((value == LLONG_MIN && errno == ERANGE) || value < minval)
+        err = "too small";
+    else if ((value == LLONG_MAX && errno == ERANGE) || value > maxval)
+        err = "too large";
+
+    if (err) {
+        if (errstrp)
+            *errstrp = err;
+        errno = ERANGE;
+        return 0;
+    }
+
+    if (errstrp)
+        *errstrp = NULL;
+    return value;
+}
+
+char *
+user_from_uid(uid_t uid, int nouser)
+{
+    static char buf[32];
+    struct passwd *pw;
+
+    if (!nouser && (pw = getpwuid(uid)) != NULL)
+        return pw->pw_name;
+    snprintf(buf, sizeof(buf), "%u", (unsigned)uid);
+    return buf;
+}
+
+char *
+group_from_gid(gid_t gid, int nogroup)
+{
+    static char buf[32];
+    struct group *gr;
+
+    if (!nogroup && (gr = getgrgid(gid)) != NULL)
+        return gr->gr_name;
+    snprintf(buf, sizeof(buf), "%u", (unsigned)gid);
+    return buf;
+}
+
+char *
+fflagstostr(unsigned long flags)
+{
+    (void)flags;
+    char *s = malloc(1);
+    if (s)
+        s[0] = '\0';
+    return s;
+}
+
+char *
+getbsize(int *headerlenp, long *blocksizep)
+{
+    static char header[] = "512-blocks";
+    char *env;
+    long size = 512;
+
+    env = getenv("BLOCKSIZE");
+    if (env && *env) {
+        char *end;
+        long parsed = strtol(env, &end, 10);
+        if (parsed > 0 && *end == '\0')
+            size = parsed;
+    }
+
+    if (headerlenp)
+        *headerlenp = 10;
+    if (blocksizep)
+        *blocksizep = size;
+    return header;
+}
